# CRLF in frozen Windows artifacts is intentional; retain their recorded bytes.
* whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
project_config.json text eol=lf
configs/** text eol=lf
.gitattributes text eol=lf
runs/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
reports/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
KNN/input/** -text
thermo/input/** -text
KNN/six_species/** -text
data/02_reg_and_gen_six_species/** -text
data/01_Ecoli_strength/*.tsv text eol=lf
data/01_Ecoli_strength/*.json text eol=lf
history/** -text
CNN/runs/** -text
analysis_m2m3/runs/** -text
analysis_m2m3/inputs/** -text
analysis_m2m3/reports/region_analysis_*/** -text
KNN/results/** -text
thermo/results/** -text
Ridge/data_snapshot/** -text
Ridge/features/** -text
Ridge/selection/** -text
Ridge/results/** -text
contracts/** -text
*.joblib -text
*.pt -text
*.npy -text
*.npz -text
*.png -text
*.zip -text

# Captured patches are immutable evidence and may contain historical whitespace.
**/source_patch.diff -whitespace

# Matplotlib SVG paths contain significant generated spacing.
*.svg -text -whitespace

# Preserve verification hashes across Windows/Linux checkouts.
data/03_Ecoli_strength87/** -text
data/04_Bsub_strength61/** -text

# Keep generated scientific artifacts collapsible in repository reviews.
runs/** linguist-generated=true
data/03_Ecoli_strength87/*.tsv linguist-generated=true
data/03_Ecoli_strength87/raw/** linguist-vendored=true
data/04_Bsub_strength61/*.tsv linguist-generated=true
results/context87/** linguist-generated=true
# Source snapshots preserve original bytes, including original trailing blank lines.
reports/source_snapshots/*.py linguist-generated=true whitespace=-blank-at-eof
