          "enum": [
            "r2",
            "spearman",
            "mae"
          ]
        },
        "target_scale": {
          "type": "str",
          "nullable": false,
          "description": "指标标签/预测尺度",
          "enum": [
            "raw",
            "log10",
            "tool_rank"
          ]
        },
        "value": {
          "type": "float",
          "nullable": true,
          "description": "指标值；undefined时空"
        },
        "n_requested": {
          "type": "int",
          "nullable": false,
          "description": "请求预测样本数",
          "min": 1
        },
        "n_success": {
          "type": "int",
          "nullable": false,
          "description": "成功预测数",
          "min": 0
        },
        "n_used": {
          "type": "int",
          "nullable": false,
          "description": "该指标真正参与数",
          "min": 0
