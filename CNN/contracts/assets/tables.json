    "metrics": {
      "description": "主评价log10、raw辅助、未经校准热力学仅tool_rank。",
      "delimiter": ",",
      "primary_key": [
        "run_id",
        "metric_name",
        "target_scale",
        "evaluation_subset",
        "comparison_set_id"
      ],
      "allow_extra_prefix": "extra_",
      "columns": {
        "dataset_id": {
          "type": "str",
          "nullable": false,
          "description": "本契约适用于课程E.coli 50 bp强度数据",
          "const": "course_ecoli50_strength"
        },
        "run_id": {
          "type": "str",
          "nullable": false,
          "description": "同一次运行唯一标识"
        },
        "method_name": {
          "type": "str",
          "nullable": false,
          "description": "方法标识，继承已有名称",
          "pattern": "[a-z][a-z0-9_]*"
        },
        "split_id": {
          "type": "str",
          "nullable": false,
          "description": "划分"
        },
        "evaluation_subset": {
          "type": "str",
          "nullable": false,
          "description": "如val_all/val_common；注明筛选ID文件"
        },
